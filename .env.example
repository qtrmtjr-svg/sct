DATABASE_URL="file:./dev.db"
# Local PostgreSQL (docker compose up db):
# DATABASE_URL="postgresql://stc:stc@localhost:5432/stc?schema=public"
# Render Persistent Disk (mount e.g. /var/data, then):
# DATABASE_URL="file:/var/data/stc.db"
# Render PostgreSQL (change prisma schema provider to postgresql first):
# DATABASE_URL="<Internal Database URL from Render Postgres>"
AUTH_SECRET="replace-with-a-long-random-string"
PAYMENT_MODE="mock"
PAYMENT_WEBHOOK_SECRET="replace-me"
AIRTIME_MODE="mock"
APP_URL="http://localhost:3000"

# Optional: visitor alert email (admin panel open → browser chime + server send)
# ADMIN_NOTIFY_EMAIL="dawajinbh@gmail.com"

# Render: default admin if missing (does not delete KNET/orders). Reset password only if RESET=true
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="Admin12345"
# BOOTSTRAP_ADMIN_RESET="true"

# Spacemail / SMTP (preferred when you have mailbox credentials)
# SMTP_HOST="mail.spacemail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="no-reply@yourdomain.com"
# SMTP_PASSWORD="set-on-render-only-never-commit"
# EMAIL_FROM="no-reply@yourdomain.com"
# Port 587 alternative: SMTP_PORT="587" SMTP_SECURE="false"

# Or Resend API instead of SMTP
# RESEND_API_KEY="re_..."
# EMAIL_FROM="STC Alerts <notify@yourdomain.com>"
